# ===================================================
# Configuración del Servidor QuantumNova
# ===================================================
PORT=5000

# Base de Datos MongoDB (Mongoose)
# Para desarrollo local (offline):
# MONGODB_URI=mongodb://127.0.0.1:27017/quantum_nova
#
# Para producción en Vercel / Nube (MongoDB Atlas GRATUITO):
# Crea tu base de datos gratuita en https://cloud.mongodb.com
# Copia tu cadena de conexión y reemplaza <usuario> y <password>:
MONGODB_URI=mongodb+srv://<usuario>:<password>@cluster0.abcde.mongodb.net/quantum_nova?retryWrites=true&w=majority

# Clave de API de Gemini (Google AI Studio)
GEMINI_API_KEY=tu_clave_de_gemini_aqui

# Clave de API de OpenAI (Opcional, dejar vacío para usar Gemini o simulación local)
OPENAI_API_KEY=
